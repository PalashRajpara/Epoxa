# App Configuration
APP_ENV=development
APP_NAME=Epoxa
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000

# Database — dedicated Supabase PostgreSQL connection string
# Direct or session mode connection: postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Or psycopg / asyncpg standard connection string
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@your-db-host:5432/postgres

# Supabase Auth
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# LiveKit (Realtime Voice)
LIVEKIT_URL=wss://your-livekit-host.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Speech Services
DEEPGRAM_API_KEY=your-deepgram-api-key

# LLM Providers (Fast groq inference by default)
GROQ_API_KEY=your-groq-api-key
# OPENAI_API_KEY=your-openai-api-key

# Policy and Retention Controls
TRANSCRIPT_RETENTION_DAYS=30
JWT_EXPECTED_AUDIENCE=authenticated
