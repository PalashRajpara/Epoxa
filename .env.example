# =============================================================================
# EPOXA — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to '.env' and populate with your own credentials.
# NEVER commit the actual '.env' file to version control.

# Application Environment ('local', 'staging', 'production')
ENVIRONMENT=local
LOG_LEVEL=INFO

# =============================================================================
# LIVEKIT CLOUD (WebRTC Audio Infrastructure)
# =============================================================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# =============================================================================
# LLM INFERENCE (Groq Cloud)
# =============================================================================
GROQ_API_KEY=your-groq-api-key
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=15.0

# =============================================================================
# SPEECH-TO-TEXT & TEXT-TO-SPEECH (Deepgram & Cartesia)
# =============================================================================
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_STT_MODEL=nova-2-general
DEEPGRAM_TTS_MODEL=aura-asteria-en
CARTESIA_API_KEY=your-cartesia-api-key

# =============================================================================
# SUPABASE POSTGRESQL & AUTHENTICATION
# =============================================================================
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-hs256-fallback

# Runtime database connection (Supavisor Transaction Pooler on port 6543)
# Example: postgresql+asyncpg://postgres.ref:password@aws-0-region.pooler.supabase.co:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@localhost:5432/epoxa

# Migration database connection (Direct / Session Pooler on port 5432)
# Example: postgresql+asyncpg://postgres.ref:password@aws-0-region.pooler.supabase.co:5432/postgres
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@localhost:5432/epoxa

# =============================================================================
# FASTAPI BACKEND CONFIGURATION
# =============================================================================
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
CONCURRENT_CALL_CAP=10
MAX_CALL_DURATION_MINUTES=10
