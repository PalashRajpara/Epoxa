# LiveKit Cloud (Get yours at https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# LLM API configuration (Groq or Cerebras) (Get yours at https://console.groq.com or https://inference.cerebras.ai)
GROQ_API_KEY=your-groq-api-key
CEREBRAS_API_KEY=your-cerebras-api-key

# Speech to Text (Deepgram) (Get yours at https://console.deepgram.com)
DEEPGRAM_API_KEY=your-deepgram-api-key

# Text to Speech (Cartesia) (Get yours at https://play.cartesia.ai)
CARTESIA_API_KEY=your-cartesia-api-key

# Backend Configuration
PORT=8000

# Phase 3: Supabase PostgreSQL (Get yours free at https://supabase.com)
# 1. Create a project at supabase.com
# 2. Go to Project Settings → API
# 3. Copy the Project URL and the 'service_role' key (NOT the anon key)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
